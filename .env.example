# Critical Save Studio — Environment Configuration Example
# Copy this file to .env and configure values before starting the application in production.
# WARNING: Never commit real .env files with actual secrets to version control!

# Secret key for cryptographic signing, session cookies & CSRF tokens.
# Generate a secure 64-character random hex string in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_HERE

# Persistence Database Connection String
# Defaults to local SQLite at data/critical_save.db
# For PostgreSQL: postgresql://user:password@localhost:5432/critical_save
DATABASE_URL=sqlite:///data/critical_save.db

# Flask Application Settings
PORT=5000
FLASK_DEBUG=0
FLASK_ENV=production

# Initial Administrator Password (used ONLY on first-time setup during seed_db.py)
# If left empty, seed_db.py automatically generates a cryptographically secure random password on first run.
INITIAL_ADMIN_PASSWORD=YOUR_INITIAL_ADMIN_PASSWORD_HERE

# Contact Form & Outbound Mail Transmission (Optional)
# If left empty, contact inquiries are safely persisted in the database queue and reviewed via the Admin portal.
CONTACT_RECIPIENT_EMAIL=contact@criticalsavestudio.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
