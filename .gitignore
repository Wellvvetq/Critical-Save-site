# ==========================================
# Critical Save Studio — Production .gitignore
# ==========================================

# 1. Environment & Secrets
.env
.env.*
!.env.example
*.env
.envrc
*.secret
*.pem
*.key

# 2. SQLite databases & runtime data
data/
data/*
*.db
*.db-journal
*.db-wal
*.db.backup
*.sqlite
*.sqlite3

# 3. Build artifacts, static freeze & packaging
dist/
build/
dist-release/
/site
*.egg-info/
.eggs/

# 4. Large installers & binaries (NEVER commit to Git)
*.exe
*.msi
*.dmg
*.blockmap
*.zip
*.tar.gz

# 5. Python runtime & bytecode caches
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# 6. Test artifacts & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# 7. Local OS & IDE configurations
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
